// See https://aka.ms/vscode-remote/devcontainer.json for format details.
{
  "name": "Kodi Search Card Development",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "context": "..",

  // ✅ Ajout de Node.js 20 via les features officielles
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },

  "appPort": ["5001:5001", "10123:8123"],

  // ✅ npm ci = plus rapide et reproductible si package-lock.json existe
  "postCreateCommand": "npm ci || npm install",

  "runArgs": [
    "-v",
    "${env:HOME}${env:USERPROFILE}/.ssh:/tmp/.ssh:ro" // lecture seule pour sécurité
  ],

  // ✅ Regroupe extensions et settings dans customizations.vscode
  "customizations": {
    "vscode": {
      "extensions": [
        "github.vscode-pull-request-github",
        "eamodio.gitlens",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bierner.lit-html",
        "runem.lit-plugin",
        "auchenberg.vscode-browser-preview",
        "davidanson.vscode-markdownlint",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "files.eol": "\n",
        "editor.tabSize": 4,
        "terminal.integrated.shell.linux": "/bin/bash",
        "editor.formatOnPaste": false,
        "editor.formatOnSave": true,
        "editor.formatOnType": true,
        "files.trimTrailingWhitespace": true
      }
    }
  }
}